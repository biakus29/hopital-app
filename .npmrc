# Skip Puppeteer's Chromium download.
# whatsapp-web.js depends on puppeteer, which by default downloads ~150MB of
# Chromium during `npm install`. On a shared host like N0C/Passenger this
# either fails (no shell deps) or wastes quota. We never run WhatsApp in
# production anyway (DISABLE_WHATSAPP=true), so we skip the download.
PUPPETEER_SKIP_DOWNLOAD=true
puppeteer_skip_chromium_download=true
