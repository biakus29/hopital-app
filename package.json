{
  "name": "st-therese-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend Express for St. Therese Hospital — blog, events, WhatsApp broadcasts",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "deploy:migrate": "prisma migrate deploy && node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.18.0",
    "qrcode-terminal": "^0.12.0",
    "slugify": "^1.6.6",
    "whatsapp-web.js": "^1.25.0",
    "zod": "^3.23.8"
  }
}
